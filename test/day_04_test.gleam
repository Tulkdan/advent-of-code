import day_04
import simplifile

pub fn read_file_test() {
  assert "
..@@.@@@@.
@@@.@.@.@@
@@@@@.@.@@
@.@@@@..@.
@@.@@@@.@@
.@@@@@@@.@
.@.@.@.@@@
@.@@@.@@@@
.@@@@@@@@.
@.@.@@@.@."
    |> day_04.format_input
    == [
      [".", ".", "@", "@", ".", "@", "@", "@", "@", "."],
      ["@", "@", "@", ".", "@", ".", "@", ".", "@", "@"],
      ["@", "@", "@", "@", "@", ".", "@", ".", "@", "@"],
      ["@", ".", "@", "@", "@", "@", ".", ".", "@", "."],
      ["@", "@", ".", "@", "@", "@", "@", ".", "@", "@"],
      [".", "@", "@", "@", "@", "@", "@", "@", ".", "@"],
      [".", "@", ".", "@", ".", "@", ".", "@", "@", "@"],
      ["@", ".", "@", "@", "@", ".", "@", "@", "@", "@"],
      [".", "@", "@", "@", "@", "@", "@", "@", "@", "."],
      ["@", ".", "@", ".", "@", "@", "@", ".", "@", "."],
    ]
}

pub fn calculate_rolls_test() {
  assert "
..@@.@@@@.
@@@.@.@.@@
@@@@@.@.@@
@.@@@@..@.
@@.@@@@.@@
.@@@@@@@.@
.@.@.@.@@@
@.@@@.@@@@
.@@@@@@@@.
@.@.@@@.@."
    |> day_04.format_input
    |> day_04.sum_rolls
    == 13
}

pub fn calculate_jolts_for_real_test() {
  let assert Ok(file) = simplifile.read("input/day_04")

  assert file
    |> day_04.format_input
    |> day_04.sum_rolls
    == 1389
}
